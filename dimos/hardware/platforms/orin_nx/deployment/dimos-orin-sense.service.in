[Unit]
Description=DimOS Orin NX sensor runtime
After=dimos-orin-storage-health.service
Requires=dimos-orin-storage-health.service
Conflicts=dimos-orin-shadow.service

[Service]
Type=simple
User=@DIMOS_RUNTIME_USER@
EnvironmentFile=/etc/dimos/orin-nx.env
Environment=PYTHONNOUSERSITE=1
WorkingDirectory=@DIMOS_REPO@
ExecStartPre=@DIMOS_PYTHON@ -m dimos.hardware.platforms.orin_nx.deployment.verify_profile --profile ${DIMOS_PROFILE}
ExecStart=/bin/bash @DIMOS_RUNNER@ sense
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
MemoryAccounting=yes
MemoryHigh=@MEMORY_HIGH_MB@M
MemoryMax=@MEMORY_MAX_MB@M
OOMPolicy=stop
TasksMax=512

[Install]
WantedBy=multi-user.target
