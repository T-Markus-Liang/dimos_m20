[Unit]
Description=HE DimOS integrated visual SLAM shadow
After=he-storage-health.service aurora930.service he-pointcloud-throttle.service he-camera-tf.service odom-publisher.service
Requires=he-storage-health.service
Wants=aurora930.service he-pointcloud-throttle.service he-camera-tf.service odom-publisher.service
Conflicts=he-dimos-sense.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/he/dimos_wd_m20
Environment=HOME=/home/ubuntu
Environment=PYTHONNOUSERSITE=1
Environment=HE_RTABMAP_MODE=mapping
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec .venv/bin/dimos run he-visual-slam-shadow'
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=30
MemoryAccounting=yes
MemoryHigh=2G
MemoryMax=2560M
OOMPolicy=stop
TasksMax=512
